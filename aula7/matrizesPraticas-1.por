programa
{
	
	funcao inicio()
	{
		/*
		 * ### Atividade 1 – Armazenar e Exibir uma Matriz

- Crie uma matriz 3x3 de números inteiros.
- Peça ao usuário para preencher os valores.
- Exiba a matriz formatada na tela.

---
		 */
		 inteiro linha[3] inteiro coluna[3]
		 cadeia vagas

		 para(inteiro i=0; i < 3; i++){
		 	
		 	escreva("Digite para preencher a vaga")
		 	leia(linha[i])	

			escreva("Digite para preencher a vaga")
			leia(coluna[i])
			
			escreva(coluna[i])
			escreva(linha[i])
		}
	}
}
